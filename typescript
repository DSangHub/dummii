"use client";

import { useState } from "react";
import { Mic, ShoppingCart, Tag, ExternalLink } from "lucide-react";

interface DealItem {
  id: string;
  title: string;
  price: string;
  originalPrice?: string;
  store: string;
  image: string;
  buyUrl: string;
}

export default function DummiiHome() {
  const [listening, setListening] = useState(false);
  const [query, setQuery] = useState("");
  const [deals, setDeals] = useState<DealItem[]>([]);
  const [loading, setLoading] = useState(false);

  // Free Native Browser Speech Recognition
  const startListening = () => {
    if (!("webkitSpeechRecognition" in window)) {
      alert("Voice input is not supported on this browser. Try Chrome or Safari.");
      return;
    }

    const recognition = new (window as any).webkitSpeechRecognition();
    recognition.continuous = false;
    recognition.interimResults = false;
    recognition.lang = "en-US";

    recognition.onstart = () => setListening(true);
    recognition.onend = () => setListening(false);

    recognition.onresult = (event: any) => {
      const text = event.results[0][0].transcript;
      setQuery(text);
      fetchDeals(text);
    };

    recognition.start();
  };

  const fetchDeals = async (searchQuery: string) => {
    setLoading(true);
    try {
      const res = await fetch("/api/deals", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ query: searchQuery }),
      });
      const data = await res.json();
      setDeals(data.deals || []);
    } catch (err) {
      console.error(err);
    } finally {
      setLoading(false);
    }
  };

  return (
    <main className="min-h-screen bg-amber-50 text-slate-900 flex flex-col items-center px-4 py-8">
      {/* Dummii Brand Banner */}
      <header className="text-center mb-6">
        <h1 className="text-4xl font-extrabold tracking-tight text-amber-600">
          dummii
        </h1>
        <p className="text-sm text-slate-600 font-medium">
          Dummy Intelligence • Tap, speak, save money.
        </p>
      </header>

      {/* Giant Voice Button */}
      <div className="w-full max-w-sm flex flex-col items-center mb-8">
        <button
          onClick={startListening}
          className={`w-32 h-32 rounded-full flex flex-col items-center justify-center shadow-xl transition transform active:scale-95 ${
            listening
              ? "bg-red-500 text-white animate-pulse"
              : "bg-amber-500 hover:bg-amber-400 text-slate-900"
          }`}
        >
          <Mic className="w-12 h-12" />
          <span className="text-xs font-bold uppercase mt-1">
            {listening ? "Listening..." : "Tap & Speak"}
          </span>
        </button>
        {query && (
          <p className="mt-4 text-lg font-bold text-slate-700 bg-white px-4 py-2 rounded-xl shadow-sm">
            "{query}"
          </p>
        )}
      </div>

      {/* Deals List with Direct 1-Click Buy Buttons */}
      <div className="w-full max-w-md space-y-4">
        {loading && (
          <div className="text-center py-8 text-slate-500 font-semibold animate-pulse">
            Finding lowest prices and sales...
          </div>
        )}

        {deals.map((item) => (
          <div
            key={item.id}
            className="bg-white p-4 rounded-2xl shadow-md border border-slate-200 flex flex-col space-y-3"
          >
            <div className="flex space-x-3 items-center">
              <img
                src={item.image}
                alt={item.title}
                className="w-20 h-20 object-contain rounded-lg bg-slate-50 p-1"
              />
              <div className="flex-1">
                <span className="text-xs font-bold text-amber-700 bg-amber-100 px-2 py-0.5 rounded-md">
                  {item.store}
                </span>
                <h2 className="text-sm font-bold text-slate-800 line-clamp-2 mt-1">
                  {item.title}
                </h2>
                <div className="flex items-baseline space-x-2 mt-1">
                  <span className="text-xl font-extrabold text-emerald-600">
                    {item.price}
                  </span>
                  {item.originalPrice && (
                    <span className="text-xs text-slate-400 line-through">
                      {item.originalPrice}
                    </span>
                  )}
                </div>
              </div>
            </div>

            {/* 1-Click Direct Merchant Buy Button */}
            <a
              href={item.buyUrl}
              target="_blank"
              rel="noopener noreferrer"
              className="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3 rounded-xl flex items-center justify-center space-x-2 shadow-sm transition"
            >
              <ShoppingCart className="w-5 h-5" />
              <span>Buy at {item.store}</span>
              <ExternalLink className="w-4 h-4 ml-1 opacity-80" />
            </a>
          </div>
        ))}
      </div>
    </main>
  );
} import { NextResponse } from "next/server";

